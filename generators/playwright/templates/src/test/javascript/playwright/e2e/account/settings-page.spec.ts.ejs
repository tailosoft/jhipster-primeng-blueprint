import { AccountHelper, type Account } from '../../support/account';
import { expect, test, withApiSession } from '../../support/fixtures';
import type { ResponseWatcher } from '../../support/network';
import {
  emailSettingsSelector,
  firstNameSettingsSelector,
  lastNameSettingsSelector,
  submitSettingsSelector,
} from '../../support/selectors';

const adminUsername = process.env.E2E_USERNAME ?? 'admin';
const adminPassword = process.env.E2E_PASSWORD ?? 'admin';
const username = process.env.E2E_USERNAME ?? 'user';
const password = process.env.E2E_PASSWORD ?? 'user';

const testUserEmail = 'user@localhost.fr';

test.describe('/account/settings', () => {
  let originalUserAccount: Account;
  let testUserAccount: Account;
  let settingsSave: ResponseWatcher;

  test.beforeAll(async ({ browser }) => {
    await withApiSession(browser, username, password, async ({ api }) => {
      const account = new AccountHelper(api);
      originalUserAccount = await account.getAccount();
      testUserAccount = { ...originalUserAccount, email: testUserEmail };

      // need to modify email because default email does not match regex in some frameworks
      expect((await account.saveAccount(testUserAccount)).status()).toBe(200);
    });
  });

  test.beforeEach(async ({ page, login, network }) => {
    settingsSave = network.watch('POST', /^\/api\/account$/);
    await login(username, password);
    await page.goto('/account/settings');
    await expect(page.locator(emailSettingsSelector)).toHaveValue(testUserEmail);
  });

  test.afterEach(async ({ account, login }) => {
    await login(username, password);
    expect((await account.saveAccount(testUserAccount)).status()).toBe(200);
  });

  test.afterAll(async ({ browser }) => {
    await withApiSession(browser, username, password, async ({ api }) => {
      expect((await new AccountHelper(api).saveAccount(originalUserAccount)).status()).toBe(200);
    });
  });

  test('should be accessible through menu', async ({ page, navbar }) => {
    await page.goto('');
    await navbar.clickOnSettingsItem();
    await expect(page).toHaveURL(/\/account\/settings$/);
  });

  test("should be able to change 'user' firstname settings", async ({ page }) => {
    await page.locator(firstNameSettingsSelector).fill('jhipster');
    await page.locator(submitSettingsSelector).click();
    expect((await settingsSave.next()).status()).toBe(200);
  });

  test("should be able to change 'user' lastname settings", async ({ page }) => {
    await page.locator(firstNameSettingsSelector).fill('jhipster');
    await page.locator(lastNameSettingsSelector).fill('retspihj');
    await page.locator(submitSettingsSelector).click();
    expect((await settingsSave.next()).status()).toBe(200);
  });

  test("should be able to change 'user' email settings", async ({ page }) => {
    await page.locator(firstNameSettingsSelector).fill('jhipster');
    await page.locator(emailSettingsSelector).fill('user@localhost.fr');
    await page.locator(submitSettingsSelector).click();
    expect((await settingsSave.next()).status()).toBe(200);
  });

  test.describe('if there is another user with an email', () => {
    let originalAdminAccount: Account;
    const testAdminEmail = 'admin@localhost.fr';

    test.beforeAll(async ({ browser }) => {
      await withApiSession(browser, adminUsername, adminPassword, async ({ api }) => {
        const account = new AccountHelper(api);
        originalAdminAccount = await account.getAccount();

        // need to modify email because default email does not match regex in some frameworks
        expect((await account.saveAccount({ ...originalAdminAccount, email: testAdminEmail })).status()).toBe(200);
      });
    });

    test.afterAll(async ({ browser }) => {
      await withApiSession(browser, adminUsername, adminPassword, async ({ api }) => {
        expect((await new AccountHelper(api).saveAccount(originalAdminAccount)).status()).toBe(200);
      });
    });

    test("should not be able to change 'user' email to same value", async ({ page }) => {
      await page.locator(firstNameSettingsSelector).fill('jhipster');
      await page.locator(emailSettingsSelector).fill(testAdminEmail);
      await page.locator(submitSettingsSelector).click();
      expect((await settingsSave.next()).status()).toBe(400);
    });
  });
});
