import { expect, test } from '../../support/fixtures';
import type { ResponseWatcher } from '../../support/network';
import {
  errorLoginSelector,
  passwordLoginSelector,
  submitLoginSelector,
  titleLoginSelector,
  usernameLoginSelector,
} from '../../support/selectors';

<%_ const inMemoryAdmin = skipUserManagement && (applicationTypeMonolith || applicationTypeGateway); _%>
const username = process.env.E2E_USERNAME ?? '<%= inMemoryAdmin ? 'admin' : 'user' %>';
const password = process.env.E2E_PASSWORD ?? '<%= inMemoryAdmin ? 'admin' : 'user' %>';

const authenticateApi = /^\/api\/<% if (authenticationTypeSession) { %>authentication<% } else { %>authenticate<% } %>$/;

test.describe('login page', () => {
  let authenticate: ResponseWatcher;

  test.beforeEach(async ({ page, navbar, network }) => {
    authenticate = network.watch('POST', authenticateApi);
    await page.goto('');
    await navbar.clickOnLoginItem();
  });

  test('greets with signin', async ({ page }) => {
    await expect(page.locator(titleLoginSelector)).toBeVisible();
  });
<%_ if (clientFrameworkAngular) { _%>

  test('greets visiting /login directly', async ({ page }) => {
    await page.goto('/login');
    await expect(page.locator(titleLoginSelector)).toBeVisible();
  });
<%_ } _%>

  test('requires username', async ({ page }) => {
    await expect(page.locator(passwordLoginSelector)).toBeVisible();
    await page.locator(passwordLoginSelector).fill('a-password');
    await page.locator(submitLoginSelector).click();
<%_ if (!clientFrameworkReact) { _%>
    expect((await authenticate.next()).status()).toBe(<% if (authenticationTypeSession) { %>401<% } else { %>400<% } %>);
<%_ } _%>
    // login page should stay open when login fails
    await expect(page.locator(titleLoginSelector)).toBeVisible();
  });

  test('requires password', async ({ page }) => {
    await expect(page.locator(usernameLoginSelector)).toBeVisible();
    await page.locator(usernameLoginSelector).fill('a-login');
    await page.locator(submitLoginSelector).click();
<%_ if (!clientFrameworkReact) { _%>
    expect((await authenticate.next()).status()).toBe(<% if (authenticationTypeSession) { %>401<% } else { %>400<% } %>);
    await expect(page.locator(errorLoginSelector)).toBeVisible();
<%_ } else { _%>
    // login page should stay open when login fails
    await expect(page.locator(titleLoginSelector)).toBeVisible();
<%_ } _%>
  });

  test('errors when password is incorrect', async ({ page }) => {
    await expect(page.locator(usernameLoginSelector)).toBeVisible();
    await page.locator(usernameLoginSelector).fill(username);
    await expect(page.locator(passwordLoginSelector)).toBeVisible();
    await page.locator(passwordLoginSelector).fill('bad-password');
    await page.locator(submitLoginSelector).click();
    expect((await authenticate.next()).status()).toBe(401);
    await expect(page.locator(errorLoginSelector)).toBeVisible();
  });

  test('go to home page when successfully logs in', async ({ page }) => {
    await expect(page.locator(usernameLoginSelector)).toBeVisible();
    await page.locator(usernameLoginSelector).fill(username);
    await expect(page.locator(passwordLoginSelector)).toBeVisible();
    await page.locator(passwordLoginSelector).fill(password);
    await page.locator(submitLoginSelector).click();
    expect((await authenticate.next()).status()).toBe(200);
    await expect.poll(() => new URL(page.url()).hash).toBe('');
  });
});
