import { expect, test } from '../../support/fixtures';
import {
<%_ if (withAdminUi) { _%>
  configurationPageHeadingSelector,
  healthPageHeadingSelector,
  logsPageHeadingSelector,
  metricsPageHeadingSelector,
<%_ } _%>
  swaggerFrameSelector,
  swaggerPageSelector,
<%_ if (generateUserManagement) { _%>
  userManagementPageHeadingSelector,
<%_ } _%>
} from '../../support/selectors';

const username = process.env.E2E_USERNAME ?? 'admin';
const password = process.env.E2E_PASSWORD ?? 'admin';

test.describe('/admin', () => {
  test.beforeEach(async ({ page, login }) => {
    await login(username, password);
    await page.goto('');
  });

<%_ if (generateUserManagement) { _%>
  test.describe('/user-management', () => {
    test('should load the page', async ({ page, navbar }) => {
      await navbar.clickOnAdminMenuItem('user-management');
      await expect(page.locator(userManagementPageHeadingSelector)).toBeVisible();
    });
  });

<%_ } _%>
<%_ if (withAdminUi) { _%>
  test.describe('/metrics', () => {
    test('should load the page', async ({ page, navbar }) => {
      await navbar.clickOnAdminMenuItem('metrics');
      await expect(page.locator(metricsPageHeadingSelector)).toBeVisible();
    });
  });

  test.describe('/health', () => {
    test('should load the page', async ({ page, navbar }) => {
      await navbar.clickOnAdminMenuItem('health');
      await expect(page.locator(healthPageHeadingSelector)).toBeVisible();
    });
  });

  test.describe('/logs', () => {
    test('should load the page', async ({ page, navbar }) => {
      await navbar.clickOnAdminMenuItem('logs');
      await expect(page.locator(logsPageHeadingSelector)).toBeVisible();
    });
  });

  test.describe('/configuration', () => {
    test('should load the page', async ({ page, navbar }) => {
      await navbar.clickOnAdminMenuItem('configuration');
      await expect(page.locator(configurationPageHeadingSelector)).toBeVisible();
    });
  });

<%_ } _%>
  test.describe('/docs', () => {
    test('should load the page', async ({ page, navbar, management }) => {
      const info = await management.getManagementInfo();
      test.skip(!info.activeProfiles.includes('api-docs'), 'the api-docs profile is not active');

      await navbar.clickOnAdminMenuItem('docs');
      await expect(page.locator(swaggerFrameSelector)).toBeVisible();

      const swagger = page.frameLocator(swaggerFrameSelector);
      await expect(swagger.locator(swaggerPageSelector)).toBeVisible({ timeout: 15_000 });
      await expect(swagger.locator('[id="select"] > option').first()).toBeAttached();
      await expect(swagger.locator(`${swaggerPageSelector} .information-container`).first()).toBeAttached();
    });
  });
<%_ if (communicationSpringWebsocket) { _%>

  test.describe('/tracker', () => {
    test('should load the page', async ({ page, navbar }) => {
      await navbar.clickOnAdminMenuItem('tracker');
      await expect(page.locator('[data-cy="trackerPageHeading"]')).toBeVisible();
      await expect(page.locator('[data-cy="trackerTable"] > tbody > tr')).toHaveCount(1);
    });
  });
<%_ } _%>
});
