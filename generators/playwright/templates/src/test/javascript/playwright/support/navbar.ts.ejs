import type { Locator, Page } from '@playwright/test';

import {
  accountMenuSelector,
  adminMenuSelector,
  entityItemSelector,
  loginItemSelector,
  logoutItemSelector,
  navbarSelector,
  passwordItemSelector,
  registerItemSelector,
  settingsItemSelector,
} from './selectors';

export class Navbar {
  constructor(private readonly page: Page) {}

  get navbar(): Locator {
    return this.page.locator(navbarSelector);
  }

  async clickOnLoginItem(): Promise<void> {
    await this.clickOnAccountMenuItem(loginItemSelector);
  }

  async clickOnLogoutItem(): Promise<void> {
    await this.clickOnAccountMenuItem(logoutItemSelector);
  }

  async clickOnRegisterItem(): Promise<void> {
    await this.clickOnAccountMenuItem(registerItemSelector);
  }

  async clickOnSettingsItem(): Promise<void> {
    await this.clickOnAccountMenuItem(settingsItemSelector);
  }

  async clickOnPasswordItem(): Promise<void> {
    await this.clickOnAccountMenuItem(passwordItemSelector);
  }

  async clickOnAdminMenuItem(item: string): Promise<void> {
    await this.navbar.locator(adminMenuSelector).click();
    await this.page.locator(`.dropdown-item[href="/admin/${item}"]`).click();
  }

  async clickOnEntityMenuItem(entityName: string): Promise<void> {
    await this.navbar.locator(entityItemSelector).click();
    await this.page.locator(`.dropdown-item[href="/${entityName}"]`).click(<% if (clientFrameworkAngular) { %>{ force: true }<% } %>);
  }

  /**
   * The menu overlays are rendered outside of the navbar, so only the trigger is scoped to it.
   */
  private async clickOnAccountMenuItem(itemSelector: string): Promise<void> {
    await this.navbar.locator(accountMenuSelector).click();
    await this.page.locator(itemSelector).click();
  }
}
