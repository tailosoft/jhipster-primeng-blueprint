import type { Page } from '@playwright/test';

import type { Api } from './api';
<%_ if (authenticationTypeOauth2) { _%>
import { getOauth2Data, oauthLogin } from './oauth2';
<%_ } _%>

<%_ if (authenticationTypeJwt) { _%>
export const authenticationUrl = '/api/authenticate';
export const jwtStorageName = '<%= jhiPrefixDashed %>-authenticationToken';
<%_ } else if (authenticationTypeSession) { _%>
export const authenticationUrl = '/api/authentication';
<%_ } _%>

/**
 * Authenticate through the API instead of the login form: the specs that assert on the
 * login page drive the form themselves, everything else just needs a session.
 */
export async function login(page: Page, <%= authenticationTypeOauth2 ? '_api' : 'api' %>: Api, username: string, password: string): Promise<void> {
<%_ if (authenticationTypeOauth2) { _%>
  const oauth2Data = await getOauth2Data(page);
  await oauthLogin(page, oauth2Data, username, password);
<%_ } else if (authenticationTypeSession) { _%>
  // Unauthenticated call, only issued so that the backend hands out the XSRF cookie.
  await page.request.get('/api/account', { failOnStatusCode: false });
  await api.authenticatedRequest({
    method: 'POST',
    url: authenticationUrl,
    form: { username, password },
  });
<%_ } else { _%>
  const response = await page.request.post(authenticationUrl, { data: { username, password } });
  if (!response.ok()) {
    throw new Error(`Authentication of '${username}' failed with ${response.status()}: ${await response.text()}`);
  }
  const { id_token: idToken } = (await response.json()) as { id_token: string };
  api.bearerToken = idToken;

  <%_ if (clientFrameworkVue) { _%>
  const storedToken = idToken;
  <%_ } else { _%>
  // The webapp reads the token back with JSON.parse, so it has to be stored JSON encoded.
  const storedToken = JSON.stringify(idToken);
  <%_ } _%>
  const storeToken = ([name, value]: [string, string]) => window.sessionStorage.setItem(name, value);
  const tokenEntry: [string, string] = [jwtStorageName, storedToken];

  // Replayed on every navigation so the application boots already authenticated.
  await page.addInitScript(storeToken, tokenEntry);
  if (!page.url().startsWith('about:')) {
    // A page is already open: seed it too, addInitScript only applies to the next navigation.
    await page.evaluate(storeToken, tokenEntry);
  }
<%_ } _%>
}
